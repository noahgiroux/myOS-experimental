#!/usr/bin/env python3
"""Synchronize UX8406 OLED brightness using normalized brightness ratios."""
from __future__ import annotations
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from current_zenbook_duo_lib import (PROFILE_DIR, brightness_value, find_backlight,
                                     hardware_status, load_profile)


def read_int(path: Path) -> int:
    return int(path.read_text().strip())


def sync(upper: Path, lower: Path) -> bool:
    try:
        value = brightness_value(read_int(upper / "brightness"), read_int(upper / "max_brightness"),
                                 read_int(lower / "max_brightness"))
        (lower / "brightness").write_text(f"{value}\n")
        return True
    except (OSError, ValueError, ZeroDivisionError):
        return False


def wait_for_backlights(profile, root: Path, attempts: int = 30) -> tuple[Path | None, Path | None]:
    for _ in range(attempts):
        upper = find_backlight(profile.upper_backlight_patterns, root)
        lower = find_backlight(profile.lower_backlight_patterns, root)
        if upper is not None and lower is not None:
            return upper, lower
        time.sleep(1)
    return None, None


def main() -> int:
    ok, _ = hardware_status(PROFILE_DIR)
    if not ok:
        return 0
    profile = load_profile(profile_dir=PROFILE_DIR)
    if profile is None:
        return 0
    root = Path(os.environ.get("ZENBOOK_DUO_BACKLIGHT_ROOT", "/sys/class/backlight"))
    once = len(sys.argv) > 1 and sys.argv[1] == "--once"
    upper, lower = wait_for_backlights(profile, root, attempts=5 if once else 30)
    if upper is None or lower is None:
        # On supported hardware this is normally a resume/device-init race.
        # Return failure so systemd's bounded restart policy retries later.
        return 0 if once else 1
    sync(upper, lower)
    if once:
        return 0
    try:
        # inotifywait is intentionally used as an event source, never as a
        # privileged command runner. Missing devices simply end the service.
        process = subprocess.Popen(["inotifywait", "-mq", "-e", "modify", str(upper / "brightness")],
                                   stdout=subprocess.PIPE, text=True)
        for _ in process.stdout or ():
            if not sync(upper, lower):
                break
    except (FileNotFoundError, OSError):
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
