#!/usr/bin/env python3
"""GNOME Wayland integration for the ASUS Zenbook Duo UX8406MA.

Automatic changes are intentionally transient and conservative: an active
external display leaves the user's GNOME layout untouched unless --force is
given to a manual command.
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from current_zenbook_duo_lib import (  # noqa: E402
    CONFIG_PATH, DRM_ROOT, PROFILE_DIR, active_internal_connectors,
    build_gdctl_command, connected_connectors, effective_connectors,
    dock_state_changed, hardware_status, has_external_monitor, keyboard_attached, load_profile,
    panels_available, read_config, toggle_target,
)


def runtime_orientation_path() -> Path:
    root = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/current-zenbook-duo-{os.getuid()}"))
    try:
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
    except OSError:
        return Path("/tmp/current-zenbook-duo-orientation")
    return root / "orientation"


def current_orientation() -> str:
    try:
        value = runtime_orientation_path().read_text().strip()
    except OSError:
        value = "normal"
    return value if value in ("normal", "bottom-up", "left-up", "right-up") else "normal"


def save_orientation(orientation: str) -> None:
    if orientation in ("normal", "bottom-up", "left-up", "right-up"):
        try:
            runtime_orientation_path().write_text(f"{orientation}\n")
        except OSError:
            pass


def profile_or_exit():
    ok, message = hardware_status(PROFILE_DIR)
    if not ok:
        print(message, file=sys.stderr)
        raise SystemExit(0)
    profile = load_profile(profile_dir=PROFILE_DIR)
    if profile is None:
        raise SystemExit(0)
    return profile


def layout_for_policy(attached: bool) -> str:
    return "top" if attached else "both"


def gdctl_show() -> str:
    return subprocess.run(["gdctl", "show"], check=True, text=True, capture_output=True).stdout


def apply_layout(profile, kind: str, orientation: str | None = None, force: bool = False,
                 drm_root: Path = DRM_ROOT) -> bool:
    config = read_config(CONFIG_PATH)
    top, bottom = effective_connectors(profile, config)
    connected = connected_connectors(drm_root)
    if not panels_available(connected, top, bottom, drm_root.exists()):
        print("UX8406 internal panels are not both available; layout skipped", file=sys.stderr)
        return False
    if has_external_monitor(connected, (top, bottom)) and not force:
        print("external monitor active; layout skipped", file=sys.stderr)
        return False
    orientation = orientation or current_orientation()
    commands = [build_gdctl_command(profile, kind, orientation, config)]
    # Some GNOME installations do not expose fractional scaling. Preserve an
    # explicit administrator setting, but make the automatic MA default fall
    # back to 2x if Mutter rejects 1.66667.
    if config.get("Display", "Scale", fallback="auto").strip().lower() == "auto":
        commands.append(build_gdctl_command(profile, kind, orientation, config, scale_override=2))
    error = None
    for command in commands:
        for attempt in range(4):
            try:
                subprocess.run(command, check=True, text=True, capture_output=True)
                return True
            except (FileNotFoundError, subprocess.CalledProcessError) as caught:
                error = caught
                if attempt < 3:
                    time.sleep(0.25 * (2 ** attempt))
    if error is not None:
        print(f"gdctl layout operation failed: {error}", file=sys.stderr)
    return False


def setup_inputs(profile) -> None:
    config = read_config(CONFIG_PATH)
    top, bottom = effective_connectors(profile, config)
    mappings = ((profile.upper_input, top), (profile.lower_input, bottom))
    for device, connector in mappings:
        values = [profile.panel_vendor, profile.panel_product, profile.panel_serial, connector]
        value = "[" + ", ".join("'" + part.replace("'", "") + "'" for part in values) + "]"
        for kind in ("touchscreens", "tablets"):
            path = f"/org/gnome/desktop/peripherals/{kind}/{device}/output"
            try:
                subprocess.run(["dconf", "write", path, value], check=True)
            except (FileNotFoundError, subprocess.CalledProcessError) as error:
                print(f"unable to map {kind} {device}: {error}", file=sys.stderr)


def orientation_from_sensor(line: str) -> str | None:
    line = line.lower()
    for orientation in ("bottom-up", "left-up", "right-up", "normal"):
        if orientation in line:
            return orientation
    return None


def synchronize(profile, orientation: str | None = None) -> bool:
    setup_inputs(profile)
    attached = keyboard_attached(profile)
    return apply_layout(profile, layout_for_policy(attached), orientation or current_orientation())


def watch_displays(profile) -> int:
    """Reconfigure only when the detachable keyboard's actual state changes."""
    previous_attached = keyboard_attached(profile)
    try:
        process = subprocess.Popen(
            ["udevadm", "monitor", "--udev", "--subsystem-match=usb", "--property"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        )
    except FileNotFoundError:
        return 1
    try:
        for line in process.stdout or ():
            # udev events are merely a wake-up; sysfs determines the state.
            if not line.startswith("ACTION="):
                continue
            current_attached = keyboard_attached(profile)
            if not dock_state_changed(previous_attached, current_attached):
                continue
            previous_attached = current_attached
            apply_layout(profile, layout_for_policy(current_attached), current_orientation())
    finally:
        process.terminate()
    return 1


def watch_rotation(profile) -> int:
    try:
        process = subprocess.Popen(["monitor-sensor", "--accel"], stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True)
    except FileNotFoundError:
        return 0
    last = current_orientation()
    try:
        for line in process.stdout or ():
            orientation = orientation_from_sensor(line)
            if orientation is None or orientation == last:
                continue
            last = orientation
            save_orientation(orientation)
            # Rotation preserves the dock-state policy; it never inverts it.
            apply_layout(profile, layout_for_policy(keyboard_attached(profile)), orientation)
    finally:
        process.terminate()
    return 0


def session(profile) -> int:
    if os.environ.get("XDG_SESSION_TYPE") not in (None, "wayland"):
        print("UX8406 session helper requires GNOME Wayland", file=sys.stderr)
        return 0
    # gdctl only succeeds after the session D-Bus/Mutter service is available.
    for _ in range(12):
        try:
            gdctl_show()
            break
        except (FileNotFoundError, subprocess.CalledProcessError):
            time.sleep(1)
    else:
        return 1
    synchronize(profile)
    children = {
        "dock": subprocess.Popen([sys.argv[0], "watch-displays"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
        "rotation": subprocess.Popen([sys.argv[0], "watch-rotation"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL),
    }
    try:
        while True:
            if children["dock"].poll() is not None:
                return 1
            # Rotation is optional: if no accelerometer is exposed, dock/undock
            # support remains active instead of repeatedly respawning it.
            if children["rotation"] is not None and children["rotation"].poll() is not None:
                children["rotation"] = None
            time.sleep(2)
    finally:
        for child in children.values():
            if child is not None:
                child.terminate()


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--force", action="store_true", help="allow manual layouts with an external monitor")
    parser.add_argument("command", choices=("check-hardware", "status", "top", "bottom", "both", "toggle",
                                              "setup-inputs", "watch-displays", "watch-rotation", "resume", "session"))
    args = parser.parse_args(argv)
    if args.command == "check-hardware":
        ok, message = hardware_status(PROFILE_DIR)
        print(message)
        return 0 if ok else 1
    profile = profile_or_exit()
    if args.command == "status":
        config = read_config(CONFIG_PATH)
        top, bottom = effective_connectors(profile, config)
        connected = connected_connectors(DRM_ROOT)
        print(f"model={profile.board} keyboard={'attached' if keyboard_attached(profile) else 'detached'}")
        print(f"connected={','.join(sorted(connected)) or 'none'} external={has_external_monitor(connected, (top, bottom))}")
        return 0
    if args.command == "setup-inputs":
        setup_inputs(profile); return 0
    if args.command in ("top", "bottom", "both"):
        return 0 if apply_layout(profile, args.command, force=args.force) else 1
    if args.command == "toggle":
        config = read_config(CONFIG_PATH)
        top, bottom = effective_connectors(profile, config)
        try:
            target = toggle_target(active_internal_connectors(gdctl_show(), (top, bottom)), top, bottom)
        except (FileNotFoundError, subprocess.CalledProcessError):
            target = "both"
        return 0 if apply_layout(profile, target, force=args.force) else 1
    if args.command == "watch-displays":
        return watch_displays(profile)
    if args.command == "watch-rotation":
        return watch_rotation(profile)
    if args.command == "resume":
        if os.environ.get("XDG_SESSION_TYPE") not in (None, "wayland"):
            return 0
        for _ in range(12):
            try:
                gdctl_show()
                break
            except (FileNotFoundError, subprocess.CalledProcessError):
                time.sleep(1)
        else:
            return 0
        synchronize(profile)
        return 0
    return session(profile)


if __name__ == "__main__":
    raise SystemExit(main())
