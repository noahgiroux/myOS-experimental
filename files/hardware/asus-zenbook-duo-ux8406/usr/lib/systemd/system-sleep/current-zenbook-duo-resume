#!/usr/bin/env python3
"""Re-sync UX8406 panel brightness after system resume."""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


if len(sys.argv) >= 2 and sys.argv[1] == "post":
    runtime = Path("/run/current-zenbook-duo")
    runtime.mkdir(mode=0o755, exist_ok=True)
    (runtime / "resume").touch()
    subprocess.run(["/usr/libexec/current-zenbook-duo-brightness", "--once"], check=False)
